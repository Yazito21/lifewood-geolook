{
  "manifest_version": 3,
  "name": "GeoLook Sampling Assistant",
  "version": "0.1.0",
  "description": "Manual AI-answer sampling assistant: loads the question queue, extracts answers and citations in one click, and posts them back to your local GeoLook dashboard. Default manual mode fills but never sends; \"auto-run queue\" must be explicitly enabled with you present, and halts on any CAPTCHA/anti-bot signal.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GeoLook Sampling Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://gemini.google.com/*",
        "https://www.google.com/*",
        "https://chatglm.cn/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://yuanbao.tencent.com/*",
        "https://yiyan.baidu.com/*",
        "https://chat.baidu.com/*",
        "https://www.n.cn/*",
        "https://bot.n.cn/*",
        "https://metaso.cn/*",
        "https://wenxin.baidu.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}